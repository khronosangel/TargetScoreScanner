@page "/"
@using TargetScoreScanner.Services
@using SharpImage = SixLabors.ImageSharp.Image
@inject ImageComparisonService ComparisonService
@inject ScoringService ScoringService

<div style="display:flex; flex-direction:column; height:97vh; overflow:hidden;">

    <!-- Images row -->
    <div style="display:flex; flex:1; overflow:hidden;">

        <!-- Left image (reference) -->
        <div style="width:50%; display:flex; align-items:center; justify-content:center; position:relative; overflow:hidden;">
            <img id="img1" src="images/TargetPaper.png" style="height:90vh; display:block;"
                 @ref="_imgRef1" />
            @if (_imageWidth > 0)
            {
                @foreach (var pt in _discrepancies)
                {
                    @* <span style="position:absolute;
                                 left:@(pt.X / (double)_imageWidth * 100)%;
                                 top:@(pt.Y / (double)_imageHeight * 100)%;
                                 width:8px; height:8px;
                                 background:red; border-radius:50%;
                                 transform:translate(-50%,-50%);
                                 pointer-events:none;" /> *@
                }
            }
        </div>

        <!-- Right image (modified) -->
        <div style="width:50%; display:flex; align-items:center; justify-content:center; position:relative; overflow:hidden;">
            <img id="img2" src="@_image2Src" style="height:90vh; display:block;" />
            @if (_imageWidth > 0)
            {
                @foreach (var pt in _discrepancies)
                {
                    @* <span style="position:absolute;
                                 left:@(pt.X / (double)_imageWidth * 100)%;
                                 top:@(pt.Y / (double)_imageHeight * 100)%;
                                 width:8px; height:8px;
                                 background:red; border-radius:50%;
                                 transform:translate(-50%,-50%);
                                 pointer-events:none;" /> *@
                }
            }
        </div>
    </div>

    <!-- Toolbar row -->
    <div style="display:flex; align-items:center; justify-content:center; gap:16px; padding:8px;">
        <button @onclick="CompareImages"
                disabled="@_isComparing"
                style="padding:8px 24px; font-size:1rem; cursor:pointer;">
            @(_isComparing ? "Comparing…" : "Compare Images")
        </button>

        <button @onclick="PickTargetImage"
                disabled="@_isPickingImage"
                style="padding:8px 24px; font-size:1rem; cursor:pointer;">
            @(_isPickingImage ? "Picking…" : "Change Target Image")
        </button>

        <button @onclick="OpenCamera"
                disabled="@_isCapturing"
                style="padding:8px 24px; font-size:1rem; cursor:pointer;">
            @(_isCapturing ? "Capturing…" : "Open Camera")
        </button>
        @if (_errorMessage is not null)
        {
            <span style="color:orange;">@_errorMessage</span>
        }
        else if (_discrepancies.Length > 0)
        {
            @* <span style="color:red; font-weight:bold;">
                @_discrepancies.Length discrepanc@(_discrepancies.Length == 1 ? "y" : "ies") found
            </span> *@
        }
        else if (_compareRan)
        {
            @* <span style="color:green; font-weight:bold;">No discrepancies found ✓</span> *@
        }
    </div>

    <!-- Score display (shown only after hits are detected) -->
    @if (_scoreResult is not null && _scoreResult.Hits.Count > 0)
    {
        <div style="overflow-y:auto; max-height:40vh; padding:0 12px 8px;">

            <!-- Per-hit table -->
            <table style="width:100%; border-collapse:collapse; font-size:0.85rem; margin-bottom:6px;">
                <thead>
                    <tr style="background:#f0f0f0;">
                        <th style="border:1px solid #ccc; padding:4px 8px;">Hit #</th>
                        <th style="border:1px solid #ccc; padding:4px 8px;">Centroid (X, Y)</th>
                        <th style="border:1px solid #ccc; padding:4px 8px;">Dist (px)</th>
                        <th style="border:1px solid #ccc; padding:4px 8px;">Norm %</th>
                        <th style="border:1px solid #ccc; padding:4px 8px;">Zone</th>
                        <th style="border:1px solid #ccc; padding:4px 8px;">Score</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < _scoreResult.Hits.Count; i++)
                    {
                        var h = _scoreResult.Hits[i];
                        <tr>
                            <td style="border:1px solid #ccc; padding:4px 8px; text-align:center;">@(i + 1)</td>
                            <td style="border:1px solid #ccc; padding:4px 8px; text-align:center;">(@h.HitX, @h.HitY)</td>
                            <td style="border:1px solid #ccc; padding:4px 8px; text-align:center;">@h.Distance</td>
                            <td style="border:1px solid #ccc; padding:4px 8px; text-align:center;">@((h.NormalisedDistance * 100).ToString("F1"))%</td>
                            <td style="border:1px solid #ccc; padding:4px 8px; text-align:center;">@ScoreLabel(h.Score)</td>
                            <td style="border:1px solid #ccc; padding:4px 8px; text-align:center; font-weight:bold; color:@ScoreColor(h.Score);">@h.Score</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr style="background:#f0f0f0; font-weight:bold;">
                        <td colspan="5" style="border:1px solid #ccc; padding:4px 8px; text-align:right;">Total Score</td>
                        <td style="border:1px solid #ccc; padding:4px 8px; text-align:center; color:@ScoreColor((int)Math.Round(_scoreResult.TotalScore / (double)_scoreResult.Hits.Count));">
                            @_scoreResult.TotalScore / @(_scoreResult.Hits.Count * 10)
                        </td>
                    </tr>
                </tfoot>
            </table>

            <!-- SVG ring diagram — one marker per hit -->
            <div style="display:flex; justify-content:center; padding-top:4px;">
                <svg width="160" height="160" viewBox="0 0 160 160">
                    @for (int ring = 1; ring <= 10; ring++)
                    {
                        double r = ring * 7.0;
                        <circle cx="80" cy="80" r="@r" fill="none"
                                stroke="#bbb" stroke-width="0.8" />
                    }
                    @foreach (var h in _scoreResult.Hits)
                    {
                        double mx = h.HitX / (double)_imageWidth  * 160;
                        double my = h.HitY / (double)_imageHeight * 160;
                        <circle cx="@mx" cy="@my" r="4"
                                fill="@ScoreColor(h.Score)" stroke="white" stroke-width="1" />
                    }
                </svg>
            </div>
        </div>
    }

    <!-- Coordinates table (shown only when discrepancies exist) -->
    @if (_discrepancies.Length > 0)
    {
        @* <div style="overflow-y:auto; max-height:20vh; padding:0 12px 8px;">
            <table style="width:100%; border-collapse:collapse; font-size:0.85rem;">
                <thead>
                    <tr style="background:#f0f0f0;">
                        <th style="border:1px solid #ccc; padding:4px 8px;">#</th>
                        <th style="border:1px solid #ccc; padding:4px 8px;">X</th>
                        <th style="border:1px solid #ccc; padding:4px 8px;">Y</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < _discrepancies.Length; i++)
                    {
                        var pt = _discrepancies[i];
                        <tr>
                            <td style="border:1px solid #ccc; padding:4px 8px; text-align:center;">@(i + 1)</td>
                            <td style="border:1px solid #ccc; padding:4px 8px; text-align:center;">@pt.X</td>
                            <td style="border:1px solid #ccc; padding:4px 8px; text-align:center;">@pt.Y</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div> *@
    }
</div>

@code {
    // -----------------------------------------------------------------------
    // Fields
    // -----------------------------------------------------------------------
    private string Image1FileName = AppContext.BaseDirectory + "wwwroot/images/TargetPaper.png";

    // When null, the bundled default is used; when set, points to a user-picked file on disk.
    private string? _pickedImage2Path = null;
    private string  Image2FileName   => _pickedImage2Path
                                        ?? AppContext.BaseDirectory + "wwwroot/images/TargetPaperHit2.png";

    // Displayed src for the right image: base64 data URI after pick, otherwise the bundled path.
    private string _image2Src = "images/TargetPaperHit2.png";

    private System.Drawing.Point[] _discrepancies = [];
    private int    _imageWidth    = 0;
    private int    _imageHeight   = 0;
    private bool   _isComparing   = false;
    private bool   _isPickingImage = false;
    private bool   _isCapturing   = false;
    private bool   _compareRan    = false;
    private string? _errorMessage = null;
    private MultiHitResult? _scoreResult = null;

    private ElementReference _imgRef1;

    // -----------------------------------------------------------------------
    // Compare button handler
    // -----------------------------------------------------------------------

    /// <summary>
    /// Loads both images from the app's wwwroot bundle via <see cref="FileSystem.OpenAppPackageFileAsync"/>
    /// and runs a pure C# pixel-by-pixel comparison using SixLabors.ImageSharp.
    /// Returns an array of (X, Y) coordinates where the images differ beyond the colour threshold.
    /// </summary>
    private async Task CompareImages()
    {
        _isComparing   = true;
        _compareRan    = false;
        _errorMessage  = null;
        _discrepancies = [];
        _scoreResult   = null;
        StateHasChanged();

        try
        {
            await using Stream stream1 = await FileSystem.OpenAppPackageFileAsync(Image1FileName);
            // Image2 is either a bundled asset or a user-picked file on disk — open accordingly.
            await using Stream stream2 = _pickedImage2Path is not null
                ? File.OpenRead(_pickedImage2Path)
                : await FileSystem.OpenAppPackageFileAsync(Image2FileName);

            // Run CPU-bound comparison on a background thread so the UI stays responsive
            var result = await Task.Run(() =>
                ComparisonService.Compare(
                    stream1,
                    stream2,
                    colorThreshold: 30,
                    sampleStep: 2));

            _discrepancies = result;

            // Cache image dimensions for overlay positioning
            if (result.Length > 0 || _imageWidth == 0)
            {
                await using Stream dimStream = await FileSystem.OpenAppPackageFileAsync(Image1FileName);
                using var tempImg = SixLabors.ImageSharp.Image.Load(dimStream);
                _imageWidth  = tempImg.Width;
                _imageHeight = tempImg.Height;
            }

            // Compute circular ring score from the hit centroid
            _scoreResult = ScoringService.Calculate(result, _imageWidth, _imageHeight);

            _compareRan = true;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            _isComparing = false;
            StateHasChanged();
        }
    }

    // -----------------------------------------------------------------------
    // Camera capture handler
    // -----------------------------------------------------------------------

    private async Task OpenCamera()
    {
        if (!MediaPicker.Default.IsCaptureSupported)
        {
            _errorMessage = "Camera capture is not supported on this device.";
            StateHasChanged();
            return;
        }

        _isCapturing  = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            var photo = await MediaPicker.Default.CapturePhotoAsync();
            if (photo is null)
                return;   // user cancelled

            _pickedImage2Path = photo.FullPath;

            // Build a base64 data URI so the <img> can display the captured file.
            await using var fs = File.OpenRead(photo.FullPath);
            var bytes = new byte[fs.Length];
            _ = await fs.ReadAsync(bytes);
            string mime = photo.FileName.EndsWith(".png", StringComparison.OrdinalIgnoreCase)
                          ? "image/png" : "image/jpeg";
            _image2Src = $"data:{mime};base64,{Convert.ToBase64String(bytes)}";

            // Reset previous results so the user knows a fresh compare is needed.
            _discrepancies = [];
            _scoreResult   = null;
            _compareRan    = false;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Camera error: {ex.Message}";
        }
        finally
        {
            _isCapturing = false;
            StateHasChanged();
        }
    }

    // -----------------------------------------------------------------------
    // Pick image handler
    // -----------------------------------------------------------------------

    private async Task PickTargetImage()
    {
        _isPickingImage = true;
        _errorMessage   = null;
        StateHasChanged();

        try
        {
            var options = new PickOptions
            {
                PickerTitle   = "Select target image",
                FileTypes     = new FilePickerFileType(new Dictionary<DevicePlatform, IEnumerable<string>>
                {
                    { DevicePlatform.Android, ["image/jpeg", "image/png"] },
                    { DevicePlatform.iOS,     ["public.image"] },
                    { DevicePlatform.WinUI,   [".png", ".jpg", ".jpeg", ".bmp", ".tiff"] },
                    { DevicePlatform.macOS,   ["public.image"] },
                }),
            };

            var file = await FilePicker.Default.PickAsync(options);
            if (file is null)
                return;   // user cancelled

            _pickedImage2Path = file.FullPath;

            // Build a base64 data URI so the <img> can display a file outside wwwroot.
            await using var fs = File.OpenRead(file.FullPath);
            var bytes = new byte[fs.Length];
            _ = await fs.ReadAsync(bytes);
            string mime = file.FileName.EndsWith(".png", StringComparison.OrdinalIgnoreCase)
                          ? "image/png" : "image/jpeg";
            _image2Src = $"data:{mime};base64,{Convert.ToBase64String(bytes)}";

            // Reset previous results so the user knows a fresh compare is needed.
            _discrepancies = [];
            _scoreResult   = null;
            _compareRan    = false;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Could not load image: {ex.Message}";
        }
        finally
        {
            _isPickingImage = false;
            StateHasChanged();
        }
    }

    // -----------------------------------------------------------------------
    // Score helpers
    // -----------------------------------------------------------------------

    private static string ScoreColor(int score) => score switch
    {
        10    => "#FFD700",   // gold  – bull's-eye
        9     => "#FF8C00",   // dark orange
        8     => "#FF4500",   // orange-red
        7     => "#DC143C",   // crimson
        6     => "#9400D3",   // violet
        5     => "#0000FF",   // blue
        4     => "#008000",   // green
        3     => "#20B2AA",   // light sea green
        2     => "#708090",   // slate grey
        _     => "#A9A9A9",   // dark grey – miss / 1
    };

    private static string ScoreLabel(int score) => score switch
    {
        10 => "Bull's-Eye 🎯",
        9  => "Inner Gold",
        8  => "Red",
        7  => "Inner Red",
        6  => "Blue",
        5  => "Inner Blue",
        4  => "Black",
        3  => "Inner Black",
        2  => "White",
        _  => "Miss / Edge",
    };
}